<Window
    x:Class="AiToolkit.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Toolkit Easy2Use"
    Width="1180"
    Height="780"
    MinWidth="940"
    MinHeight="640"
    Background="{StaticResource WindowBrush}"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    ResizeMode="CanResize"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="NavigationTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#243128" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#42604B" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#090B09" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2B302B" />
            <Setter Property="RowBackground" Value="#101310" />
            <Setter Property="AlternatingRowBackground" Value="#141714" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#223229" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="44"
                Height="44"
                VerticalAlignment="Top"
                Background="#050605"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Image
                    Width="32"
                    Height="32"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="Assets/aitoolkit-icon.png"
                    Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,-2,0,0">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="AI Toolkit Easy2Use" />
                <TextBlock
                    Margin="1,4,0,0"
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Windows 管理器" />
                    <Run Text="  ·  版本 " />
                    <Run Text="{Binding VersionText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Border
                Grid.Column="2"
                Height="34"
                Padding="12,0"
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#687068" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUiRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding ServiceStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <RadioButton
                    x:Name="DashboardNav"
                    GroupName="MainNavigation"
                    IsChecked="True"
                    Style="{StaticResource NavigationTabStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE80F;" />
                        <TextBlock Margin="8,0,0,0" Text="启动管理" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="ModelsNav"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationTabStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8B7;" />
                        <TextBlock Margin="8,0,0,0" Text="模型管理" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Border
                x:Name="RestartNotice"
                Grid.Column="1"
                Height="32"
                Padding="10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#2B2415"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTip="更新已完成。关闭并重新打开启动器后，新功能才会生效。"
                Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Foreground="{StaticResource WarningBrush}"
                        Text="&#xE7BA;" />
                    <TextBlock
                        Margin="7,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource WarningBrush}"
                        Text="需要重启应用以完成更新"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,8,0,0"
            Visibility="{Binding IsChecked, ElementName=DashboardNav, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="21"
                        Foreground="{StaticResource InfoBrush}"
                        Text="&#xE7F4;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="GPU" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding GpuName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding GpuDetail}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="{StaticResource AccentBrush}"
                        Text="&#xE950;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="运行环境" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding EnvironmentStatus}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding EnvironmentDetail}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding EnvironmentDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="{StaticResource WarningBrush}"
                        Text="&#xE895;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="更新状态" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding UpdateStatus}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="14,14,6,6"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding IsChecked, ElementName=DashboardNav, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel>
                <Button
                    Command="{Binding InstallCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="安装缺失的运行环境">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE896;" />
                        <TextBlock Margin="8,0,0,0" Text="安装环境" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding CheckUpdatesCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="检查代码和依赖更新">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE895;" />
                        <TextBlock Margin="8,0,0,0" Text="检查更新" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding RepairCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="仅修复环境诊断发现的失败项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE90F;" />
                        <TextBlock Margin="8,0,0,0" Text="修复环境" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding UpdateCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="更新程序并同步依赖">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE72C;" />
                        <TextBlock Margin="8,0,0,0" Text="执行更新" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding DoctorCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="检查 Python、PyTorch、CUDA、Node、FFmpeg 和 Git">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE9D9;" />
                        <TextBlock Margin="8,0,0,0" Text="环境诊断" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding StartCommand}"
                    Style="{StaticResource StartButtonStyle}"
                    ToolTip="启动 AI Toolkit 服务">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="&#xE768;" />
                        <TextBlock Margin="8,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="启动" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding StopCommand}"
                    Style="{StaticResource StopButtonStyle}"
                    ToolTip="停止启动器管理的完整进程树">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE71A;" />
                        <TextBlock Margin="8,0,0,0" Text="停止" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding OpenCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="在默认浏览器中打开界面">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE8A7;" />
                        <TextBlock Margin="8,0,0,0" Text="打开界面" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <Border
            Grid.Row="6"
            Background="#090B09"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding IsChecked, ElementName=DashboardNav, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="&#xE756;" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Text="运行日志" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Margin="0,4,6,4"
                        Command="{Binding ClearLogsCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="清空日志">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE74D;" />
                    </Button>
                </Grid>

                <ListBox
                    x:Name="LogList"
                    Grid.Row="1"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Logs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Top"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="#707870"
                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                <Border Grid.Column="1" Width="3" CornerRadius="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#515851" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="success">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="warning">
                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="error">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="info">
                                                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock
                                    Grid.Column="3"
                                    FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                    FontSize="12"
                                    Foreground="#D5DAD5"
                                    Text="{Binding Message}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Grid.RowSpan="5"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding IsChecked, ElementName=ModelsNav, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,10,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="本地模型检查" />
                        <TextBlock
                            MaxWidth="760"
                            Margin="0,4,0,0"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="10"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ModelsRoot}">
                            <Run FontFamily="Microsoft YaHei UI" Text="便携模型目录：" />
                            <Run Text="{Binding ModelsRoot, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            x:Name="ConfiguredModelsRootText"
                            MaxWidth="760"
                            Margin="0,3,0,0"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="10"
                            Foreground="{StaticResource WarningBrush}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ConfiguredModelsRoot}">
                            <Run FontFamily="Microsoft YaHei UI" Text="MiniMax 模型目录：" />
                            <Run Text="{Binding ConfiguredModelsRoot, Mode=OneWay}" />
                            <Run FontFamily="Microsoft YaHei UI" Text="  ·  可在设置中指向 ComfyUI 的 models 目录" />
                        </TextBlock>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Height="38"
                        MinWidth="106"
                        Margin="0,0,8,0"
                        Command="{Binding CopyQuarkShareCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="复制夸克网盘模型下载地址">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8C8;" />
                            <TextBlock Margin="8,0,0,0" Text="夸克网盘" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Height="38"
                        MinWidth="106"
                        Margin="0,0,8,0"
                        Command="{Binding OpenModelsDirectoryCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="打开便携版 models 目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE8B7;" />
                            <TextBlock Margin="8,0,0,0" Text="打开目录" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        Height="38"
                        MinWidth="106"
                        Margin="0"
                        Command="{Binding ScanModelsCommand}"
                        Style="{StaticResource StartButtonStyle}"
                        ToolTip="重新检查模型名称、路径和必需文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE721;" />
                            <TextBlock Margin="8,0,0,0" Text="扫描模型" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="16,0"
                    Background="#141714"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding ModelSummaryText}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="下载按钮仅打开官方页面，不会自动安装" />
                    </Grid>
                </Border>

                <DataGrid
                    x:Name="ModelGrid"
                    Grid.Row="2"
                    ItemsSource="{Binding Models}"
                    Style="{StaticResource ModelGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="90" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="ready">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="missing">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="incomplete">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="misplaced">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="name_mismatch">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="180" Header="模型">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding FamilyCategoryLabel}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="240" Header="训练器读取路径">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="10"
                                        Foreground="#C6CDC6"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding AbsolutePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" MinWidth="220" Header="检查结果">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Detail}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="100" Header="获取模型">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Height="30"
                                        MinWidth="80"
                                        Margin="0"
                                        Padding="9,0"
                                        Command="{Binding DataContext.OpenModelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        ToolTip="在浏览器中打开官方模型仓库"
                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE896;" />
                                            <TextBlock Margin="6,0,0,0" Text="官方页面" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Grid.ColumnSpan="2"
                Height="3"
                Margin="0,7,0,0"
                VerticalAlignment="Top"
                Background="#252925"
                BorderThickness="0"
                Foreground="{StaticResource AccentBrush}"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                Margin="0,13,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding StatusText}" />
            <TextBlock
                Grid.Column="1"
                MaxWidth="620"
                Margin="16,13,0,0"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="10"
                Foreground="#717971"
                Text="{Binding ManagedRoot}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ManagedRoot}" />
        </Grid>
    </Grid>
</Window>
