<Window
    x:Class="AiToolkit.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Toolkit Easy2Use"
    Width="1180"
    Height="780"
    MinWidth="940"
    MinHeight="640"
    Background="{StaticResource WindowBrush}"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    ResizeMode="CanResize"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="44"
                Height="44"
                VerticalAlignment="Top"
                Background="{StaticResource AccentBrush}"
                CornerRadius="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Semibold"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="#07140C"
                    Text="AI" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,-2,0,0">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="AI Toolkit Easy2Use" />
                <TextBlock
                    Margin="1,4,0,0"
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Windows 管理器" />
                    <Run Text="  ·  版本 " />
                    <Run Text="{Binding VersionText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Border
                Grid.Column="2"
                Height="34"
                Padding="12,0"
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#687068" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUiRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding ServiceStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="21"
                        Foreground="{StaticResource InfoBrush}"
                        Text="&#xE7F4;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="GPU" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding GpuName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding GpuDetail}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="{StaticResource AccentBrush}"
                        Text="&#xE950;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="运行环境" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding EnvironmentStatus}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding EnvironmentDetail}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding EnvironmentDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0" Style="{StaticResource StatusPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="{StaticResource WarningBrush}"
                        Text="&#xE895;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="更新状态" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding UpdateStatus}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="14,14,6,6"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <WrapPanel>
                <Button
                    Command="{Binding InstallCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="安装缺失的运行环境">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE896;" />
                        <TextBlock Margin="8,0,0,0" Text="安装环境" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding CheckUpdatesCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="检查代码和依赖更新">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE895;" />
                        <TextBlock Margin="8,0,0,0" Text="检查更新" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding RepairCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="仅修复环境诊断发现的失败项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE90F;" />
                        <TextBlock Margin="8,0,0,0" Text="修复环境" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding UpdateCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="更新程序并同步依赖">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE72C;" />
                        <TextBlock Margin="8,0,0,0" Text="执行更新" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding DoctorCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="检查 Python、PyTorch、CUDA、Node、FFmpeg 和 Git">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE9D9;" />
                        <TextBlock Margin="8,0,0,0" Text="环境诊断" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding StartCommand}"
                    Style="{StaticResource StartButtonStyle}"
                    ToolTip="启动 AI Toolkit 服务">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="&#xE768;" />
                        <TextBlock Margin="8,0,0,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="启动" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding StopCommand}"
                    Style="{StaticResource StopButtonStyle}"
                    ToolTip="停止启动器管理的完整进程树">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE71A;" />
                        <TextBlock Margin="8,0,0,0" Text="停止" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding OpenCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="在默认浏览器中打开界面">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE8A7;" />
                        <TextBlock Margin="8,0,0,0" Text="打开界面" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <Border
            Grid.Row="5"
            Background="#090B09"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="&#xE756;" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Text="运行日志" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Margin="0,4,6,4"
                        Command="{Binding ClearLogsCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="清空日志">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE74D;" />
                    </Button>
                </Grid>

                <ListBox
                    x:Name="LogList"
                    Grid.Row="1"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Logs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Top"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="#707870"
                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                <Border Grid.Column="1" Width="3" CornerRadius="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#515851" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="success">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="warning">
                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="error">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="info">
                                                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock
                                    Grid.Column="3"
                                    FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                    FontSize="12"
                                    Foreground="#D5DAD5"
                                    Text="{Binding Message}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Grid.ColumnSpan="2"
                Height="3"
                Margin="0,7,0,0"
                VerticalAlignment="Top"
                Background="#252925"
                BorderThickness="0"
                Foreground="{StaticResource AccentBrush}"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                Margin="0,13,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding StatusText}" />
            <TextBlock
                Grid.Column="1"
                MaxWidth="620"
                Margin="16,13,0,0"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="10"
                Foreground="#717971"
                Text="{Binding ManagedRoot}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ManagedRoot}" />
        </Grid>
    </Grid>
</Window>
